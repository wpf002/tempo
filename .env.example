# Claude API key for the coach. Stays in the daemon, never sent to the browser.
ANTHROPIC_API_KEY=
# Coach model. Sonnet is the cost/quality sweet spot for per-move explanations.
TEMPO_MODEL=claude-sonnet-5-5

# Stockfish binary (brew install stockfish)
STOCKFISH_PATH=/opt/homebrew/bin/stockfish
STOCKFISH_THREADS=4
STOCKFISH_HASH_MB=256
# Live analysis budget per position, ms
TEMPO_LIVE_MOVETIME_MS=1000
# Post-game review budget per position, ms
TEMPO_REVIEW_MOVETIME_MS=600

# Lichess: personal token with the board:play scope only.
# Create at https://lichess.org/account/oauth/token/create?scopes[]=board:play&description=Tempo
LICHESS_TOKEN=

# Chess.app reader (built by scripts/bootstrap.sh)
TEMPO_WATCH_PATH=./native/tempo-watch/.build/release/tempo-watch
# On-screen overlay (built by scripts/bootstrap.sh). 1 floats the coach over the game window, 0 turns it off.
TEMPO_OVERLAY=1
TEMPO_OVERLAY_PATH=./native/tempo-watch/.build/release/tempo-overlay
# Which sources to run: lichess, chessapp, or both
TEMPO_SOURCES=lichess,chessapp

# Local daemon. Binds to 127.0.0.1 only.
TEMPO_PORT=4848
TEMPO_WEB_ORIGIN=http://localhost:3100
TEMPO_DB_PATH=~/.tempo/tempo.db

# Web panel
NEXT_PUBLIC_TEMPO_DAEMON=http://localhost:4848
